#!/bin/sh
# AppImage entry point for Hakchi2 CE: runs the app on the Mono runtime bundled in this AppImage.
# Options: --remove-desktop-entry / --add-desktop-entry  (app menu entry for this AppImage file)
here="$(dirname "$(readlink -f "$0")")"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hakchi2-ce"
desktop_file="${XDG_DATA_HOME:-$HOME/.local/share}/applications/hakchi2-ce.desktop"
icon_file="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps/hakchi2-ce.png"

if [ "${1:-}" = "--remove-desktop-entry" ]; then
  rm -f "$desktop_file"
  mkdir -p "$config_dir" && touch "$config_dir/no-desktop-entry"
  echo "hakchi: removed the app menu entry"
  exit 0
fi
if [ "${1:-}" = "--add-desktop-entry" ]; then
  rm -f "$config_dir/no-desktop-entry"
  shift
fi

# App menu entry pointing at this AppImage file; rewritten when the file moves.
if [ -n "${APPIMAGE:-}" ] && [ ! -e "$config_dir/no-desktop-entry" ] \
    && ! grep -qF "Exec=\"$APPIMAGE\"" "$desktop_file" 2>/dev/null; then
  mkdir -p "${desktop_file%/*}" "${icon_file%/*}"
  cp "$here/hakchi2-ce.png" "$icon_file"
  cat > "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Name=Hakchi2 CE
GenericName=NES/SNES Classic game manager
Comment=Add more games to your NES/SNES Classic Mini
Exec="$APPIMAGE"
Icon=hakchi2-ce
Terminal=false
Categories=Game;
Keywords=nes;snes;famicom;classic;mini;hakchi;
EOF
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "${desktop_file%/*}" 2>/dev/null
  echo "hakchi: added Hakchi2 CE to your app menu"
fi

export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
cd "$here/opt/hakchi2-ce" || exit 1
exec "$here/usr/bin/mono" hakchi.exe "$@"
